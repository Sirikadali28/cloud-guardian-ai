# Cloud Guardian AI - Configuration Template
# Copy this to .env and update with your values

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Terraform Variables
TF_VAR_aws_region=us-east-1
TF_VAR_project_name=cloud-guardian-ai

# SNS Configuration
TF_VAR_sns_email=your-email@example.com

# Lambda Configuration (set by Terraform)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT-ID:cloud-guardian-alerts

# Kinesis Configuration
KINESIS_STREAM_NAME=cloud-guardian-events

# S3 Data Lake
S3_BUCKET_NAME=cloud-guardian-data-lake-ACCOUNT-ID

# Optional: For local testing
MOCK_AWS_CREDENTIALS=false
